{
  "id": "/app",
  "name": "Qrypt",
  "short_name": "Qrypt",
  "description": "The post-quantum wallet: Falcon-512 signatures, gas paid in USDC, Face ID unlock.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0d0f",
  "theme_color": "#0c0d0f",
  "categories": ["finance"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Receive", "url": "/app#receive", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan to pay", "url": "/app#scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
