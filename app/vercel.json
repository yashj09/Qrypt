{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/dapp",
      "destination": "/index.html"
    },
    {
      "source": "/pay",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|app|connect|assets/|icons/|sw\\.js|manifest\\.webmanifest).*)",
      "has": [
        {
          "type": "host",
          "value": "qpay-psi.vercel.app"
        }
      ],
      "destination": "https://www.qrypt.money/:path",
      "permanent": false
    }
  ]
}
