{
  "manifest_version": 3,
  "name": "Eyrie",
  "version": "0.1.0",
  "description": "Post-quantum wallet for EIP-8141: Falcon-512 accounts, gas paid in USDC. Approvals open the Eyrie web wallet.",
  "icons": { "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Eyrie", "default_icon": { "128": "icon-128.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inpage.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "externally_connectable": { "matches": ["https://qpay-psi.vercel.app/*", "http://localhost:5180/*"] },
  "permissions": ["storage"],
  "host_permissions": ["https://altmempool.forshtat.com/*"]
}
